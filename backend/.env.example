[TEMPLATE]
# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=ai_chat_mvp
# Dev convenience only - use real migrations in production
DB_SYNCHRONIZE=true

# Backend
PORT=4000

# JWT - use a long random value in any real deployment
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=1d

# Initial admin seeded at startup if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# AI
AI_REQUEST_TIMEOUT_MS=60000

# ---- File uploads & background processing (Day 5-6) ----
# Max upload size per file, in bytes (default 10 MB)
FILE_MAX_SIZE_BYTES=10485760
# Extracted text sent to the AI per message, across all attached files
FILE_MAX_CONTEXT_CHARS=24000
# Max files attachable to a single message (mirrors the UI cap)
FILE_MAX_PER_MESSAGE=6
# Bounds one extraction run; a stuck job fails instead of blocking a worker slot
FILE_PROCESSING_TIMEOUT_MS=120000
# A PROCESSING row idle longer than this is re-enqueued by the orphan sweeper
FILE_STALE_PROCESSING_MS=600000

# Object storage (MinIO). Local dev defaults match infra/docker-compose.yml.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat-files

# Queue broker (BullMQ over Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Web search (opt-in per chat turn; Serper for the MVP).
# The key is never committed — keep the real value in .env only.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=serper
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=5000
WEB_SEARCH_MAX_QUERY_LENGTH=500
WEB_SEARCH_MAX_CONTEXT_CHARS=6000

# OCR (tesseract.js). Language data is downloaded on first use and cached
# outside the repository by default. OCR runs in a dedicated child process.
OCR_LANGUAGE=eng
# Optional: override the tesseract cache directory
# OCR_CACHE_PATH=
# Optional: local tessdata directory for air-gapped installs (skips download)
# OCR_DATA_PATH=
# Optional: per-attempt OCR time budget in ms; the OCR child is killed after it
# OCR_TIMEOUT_MS=90000
